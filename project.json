{
  "name": "AbitudiniLocale",
  "options": {
    "bundleIdPrefix": "local.abitudinilocale",
    "deploymentTarget": {
      "iOS": "18.0"
    },
    "createIntermediateGroups": true
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "TARGETED_DEVICE_FAMILY": "1,2",
      "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
      "MARKETING_VERSION": "1.1",
      "CURRENT_PROJECT_VERSION": "2",
      "CODE_SIGN_STYLE": "Automatic",
      "SWIFT_STRICT_CONCURRENCY": "minimal"
    }
  },
  "targets": {
    "AbitudiniLocale": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        "App",
        "Core",
        "Shared"
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "local.abitudinilocale.habits",
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
          "GENERATE_INFOPLIST_FILE": "YES"
        }
      },
      "info": {
        "path": "Generated/App-Info.plist",
        "properties": {
          "CFBundleDisplayName": "Abitudini Locale",
          "CFBundleDevelopmentRegion": "it",
          "CFBundleLocalizations": [
            "it"
          ],
          "CFBundleShortVersionString": "1.1",
          "CFBundleVersion": "2",
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ],
          "UIApplicationSceneManifest": {
            "UIApplicationSupportsMultipleScenes": false
          },
          "ITSAppUsesNonExemptEncryption": false,
          "CFBundleURLTypes": [
            {
              "CFBundleURLName": "local.abitudinilocale.habits",
              "CFBundleURLSchemes": [
                "abitudinilocale"
              ]
            }
          ]
        }
      }
    },
    "AbitudiniLocaleUITests": {
      "type": "bundle.ui-testing",
      "platform": "iOS",
      "sources": [
        "UITests"
      ],
      "dependencies": [
        {
          "target": "AbitudiniLocale"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "local.abitudinilocale.uitests",
          "GENERATE_INFOPLIST_FILE": "YES",
          "TEST_TARGET_NAME": "AbitudiniLocale"
        }
      }
    }
  },
  "schemes": {
    "AbitudiniLocale": {
      "build": {
        "targets": {
          "AbitudiniLocale": "all",
          "AbitudiniLocaleUITests": [
            "test"
          ]
        }
      },
      "test": {
        "targets": [
          "AbitudiniLocaleUITests"
        ],
        "gatherCoverageData": false
      }
    }
  }
}
