{
  "name": "Promessa",
  "options": {
    "deploymentTarget": {
      "iOS": "17.0"
    },
    "createIntermediateGroups": true
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "TARGETED_DEVICE_FAMILY": "1",
      "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
      "MARKETING_VERSION": "1.0",
      "CURRENT_PROJECT_VERSION": "1",
      "SWIFT_STRICT_CONCURRENCY": "minimal",
      "CODE_SIGN_STYLE": "Automatic"
    }
  },
  "targets": {
    "Promessa": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        "App",
        "Core"
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "local.promessa.wedding",
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
          "GENERATE_INFOPLIST_FILE": "YES"
        }
      },
      "info": {
        "path": "Generated/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Promessa",
          "CFBundleDevelopmentRegion": "it",
          "CFBundleLocalizations": [
            "it"
          ],
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ],
          "UIApplicationSceneManifest": {
            "UIApplicationSupportsMultipleScenes": false
          },
          "ITSAppUsesNonExemptEncryption": false
        }
      }
    },
    "PromessaUITests": {
      "type": "bundle.ui-testing",
      "platform": "iOS",
      "sources": [
        "UITests"
      ],
      "dependencies": [
        {
          "target": "Promessa"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "local.promessa.uitests",
          "GENERATE_INFOPLIST_FILE": "YES",
          "TEST_TARGET_NAME": "Promessa"
        }
      }
    }
  },
  "schemes": {
    "Promessa": {
      "build": {
        "targets": {
          "Promessa": "all",
          "PromessaUITests": [
            "test"
          ]
        }
      },
      "test": {
        "targets": [
          "PromessaUITests"
        ],
        "gatherCoverageData": false
      }
    }
  }
}