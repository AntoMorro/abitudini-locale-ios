{
  "name": "AbitudiniLocale",
  "options": {
    "bundleIdPrefix": "local.abitudinilocale",
    "deploymentTarget": {
      "iOS": "18.0",
      "watchOS": "11.0"
    },
    "createIntermediateGroups": true
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "TARGETED_DEVICE_FAMILY": "1,2",
      "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
      "MARKETING_VERSION": "2.1",
      "CURRENT_PROJECT_VERSION": "11",
      "CODE_SIGN_STYLE": "Automatic",
      "SWIFT_STRICT_CONCURRENCY": "minimal"
    }
  },
  "targets": {
    "AbitudiniLocale": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        "App",
        "Core",
        "Shared"
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "local.abitudinilocale.habits",
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
          "GENERATE_INFOPLIST_FILE": "YES"
        }
      },
      "info": {
        "path": "Generated/App-Info.plist",
        "properties": {
          "CFBundleDisplayName": "Quaderno Locale",
          "CFBundleDevelopmentRegion": "it",
          "CFBundleLocalizations": [
            "it"
          ],
          "CFBundleShortVersionString": "2.1",
          "CFBundleVersion": "11",
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ],
          "UIApplicationSceneManifest": {
            "UIApplicationSupportsMultipleScenes": false
          },
          "ITSAppUsesNonExemptEncryption": false,
          "CFBundleURLTypes": [
            {
              "CFBundleURLName": "local.abitudinilocale.habits",
              "CFBundleURLSchemes": [
                "abitudinilocale"
              ]
            }
          ],
          "NSMicrophoneUsageDescription": "Registra una nota vocale da allegare alla tua pagina.",
          "NSFaceIDUsageDescription": "Proteggi il tuo quaderno personale con Face ID.",
          "NSRemindersFullAccessUsageDescription": "Importa nel journal i promemoria della lista che scegli, anche quelli creati con Siri su Apple Watch."
        }
      },
      "dependencies": [
        {
          "target": "QuadernoWatch",
          "embed": true
        }
      ]
    },
    "AbitudiniLocaleUITests": {
      "type": "bundle.ui-testing",
      "platform": "iOS",
      "sources": [
        "UITests/QuadernoUITests.swift"
      ],
      "dependencies": [
        {
          "target": "AbitudiniLocale"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "local.abitudinilocale.uitests",
          "GENERATE_INFOPLIST_FILE": "YES",
          "TEST_TARGET_NAME": "AbitudiniLocale"
        }
      }
    },
    "QuadernoWatch": {
      "type": "application",
      "platform": "watchOS",
      "deploymentTarget": "11.0",
      "sources": [
        "Watch",
        "Core/JournalWatchProtocol.swift"
      ],
      "dependencies": [
        {
          "target": "QuadernoWatchWidgets",
          "embed": true
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "local.abitudinilocale.habits.watchkitapp",
          "TARGETED_DEVICE_FAMILY": "4",
          "WATCHOS_DEPLOYMENT_TARGET": "11.0",
          "GENERATE_INFOPLIST_FILE": "YES",
          "SWIFT_STRICT_CONCURRENCY": "minimal",
          "ASSETCATALOG_COMPILER_APPICON_NAME": ""
        }
      },
      "info": {
        "path": "Generated/Watch-Info.plist",
        "properties": {
          "CFBundleDisplayName": "Quaderno",
          "CFBundleShortVersionString": "2.1",
          "CFBundleVersion": "11",
          "WKApplication": true,
          "WKCompanionAppBundleIdentifier": "local.abitudinilocale.habits",
          "WKRunsIndependentlyOfCompanionApp": false,
          "CFBundleURLTypes": [
            {
              "CFBundleURLName": "quaderno.watch.capture",
              "CFBundleURLSchemes": [
                "quaderno-watch"
              ]
            }
          ]
        }
      }
    },
    "QuadernoWatchWidgets": {
      "type": "app-extension",
      "platform": "watchOS",
      "deploymentTarget": "11.0",
      "sources": [
        "WatchWidget"
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "local.abitudinilocale.habits.watchkitapp.capture",
          "TARGETED_DEVICE_FAMILY": "4",
          "WATCHOS_DEPLOYMENT_TARGET": "11.0",
          "GENERATE_INFOPLIST_FILE": "YES",
          "APPLICATION_EXTENSION_API_ONLY": "YES",
          "SKIP_INSTALL": "YES"
        }
      },
      "info": {
        "path": "Generated/WatchWidget-Info.plist",
        "properties": {
          "CFBundleDisplayName": "Annota",
          "CFBundleShortVersionString": "2.1",
          "CFBundleVersion": "11",
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.widgetkit-extension"
          }
        }
      }
    }
  },
  "schemes": {
    "AbitudiniLocale": {
      "build": {
        "targets": {
          "AbitudiniLocale": "all",
          "AbitudiniLocaleUITests": [
            "test"
          ]
        }
      },
      "test": {
        "targets": [
          "AbitudiniLocaleUITests"
        ],
        "gatherCoverageData": false
      }
    },
    "QuadernoWatch": {
      "build": {
        "targets": {
          "QuadernoWatch": "all"
        }
      }
    }
  }
}